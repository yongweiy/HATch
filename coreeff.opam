  "ocaml" {>= "5.1" & < "5.5"}
  "core" {>= "v0.17" & < "v0.18"}
  "core_unix" {>= "v0.17" & < "v0.18"}
  "core_kernel" {>= "v0.17" & < "v0.18"}
  "ppx_jane" {>= "v0.17" & < "v0.18"}
  "ppx_let"
  "ppx_inline_test"
  "ppx_assert"
  "ppx_optcomp"
  "ppx_compare"
  "ppx_sexp_conv"
  "ppx_hash"
  "ppx_here"
  "containers"
  "yojson"
  "dolog"
  "ocolor"
  "qcheck"
  "choice"
  "oseq"
  "ocamlgraph"
  "z3" {< "4.14"}
